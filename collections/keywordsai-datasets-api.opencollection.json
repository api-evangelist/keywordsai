{
  "opencollection": "1.0.0",
  "info": {
    "name": "Keywords AI Datasets API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Datasets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List datasets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.keywordsai.co/api/datasets/"
          },
          "docs": "List datasets"
        },
        {
          "info": {
            "name": "Create a dataset",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.keywordsai.co/api/datasets/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a dataset"
        }
      ]
    }
  ],
  "bundled": true
}